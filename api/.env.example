# 이 파일을 .env로 복사한 뒤 실제 발급값을 입력하세요.
# GOOGLE_CLIENT_ID=발급값
# GOOGLE_CLIENT_SECRET=발급값
# KAKAO_CLIENT_ID=발급값
# KAKAO_CLIENT_SECRET=발급값

# 로컬에서는 아래 기본값을 그대로 사용할 수 있습니다.
WEB_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
JWT_SECRET=change-this-to-a-long-random-secret
# 로그인 쿠키(SEC-011)의 Secure·`__Host-` 접두사를 끈다. http://localhost 개발에서만 false 로 둔다
# (Safari 는 http 에서 Secure 쿠키를 받지 않는다). 운영(Railway)에는 넣지 않는다. 기본값은 true.
AUTH_COOKIE_SECURE=false

# 운영 PostgreSQL을 직접 연결할 때 사용합니다.
# DATABASE_URL=jdbc:postgresql://host:5432/database
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=password
# SEED_DEMO=false
