# ─── 필수 ────────────────────────────────────────────────────
# Next.js 서버가 /backend/* 요청을 전달할 API 주소입니다.
API_ORIGIN=http://localhost:8080

# ─── 운영 배포에 필수 ────────────────────────────────────────
# 소셜 로그인은 세션 쿠키를 API 도메인에 심어야 하므로 /backend 프록시로 시작할 수 없습니다.
# 반드시 API 의 실제 출처를 지정하세요. 값이 없으면 소셜 로그인 버튼이 숨겨집니다.
# NEXT_PUBLIC_OAUTH_URL=https://api.toogeduler.com

# 로컬 데모 계정 안내를 표시합니다. 운영에서는 false 로 설정하세요.
NEXT_PUBLIC_SHOW_DEMO=true

# ─── 선택 ────────────────────────────────────────────────────
# 다른 도메인의 API 를 브라우저에서 직접 호출할 때만 설정하세요.
# 일반 배포에서는 API_ORIGIN 과 /backend 프록시를 사용합니다.
# NEXT_PUBLIC_API_URL=https://api.example.com

# ─── 모바일 빌드 전용 (셸에서 지정, .env 파일이 아님) ─────────
# 네이티브 앱이 로드할 운영 웹 주소입니다. 없으면 mobile:sync 가 실패합니다.
#   CAPACITOR_SERVER_URL=https://app.toogeduler.com npm run mobile:sync
