API_ORIGIN=http://localhost:8080

# 소셜 로그인은 세션 쿠키 유지를 위해 API 도메인에서 직접 시작합니다.
# 운영 환경에서는 배포한 API 주소를 지정하세요.
# NEXT_PUBLIC_OAUTH_URL=https://api.toogeduler.com

# 로컬 데모 계정 안내를 표시합니다. 운영에서는 false로 설정하세요.
NEXT_PUBLIC_SHOW_DEMO=true

# 다른 도메인의 API를 브라우저에서 직접 호출할 때만 설정하세요.
# 일반 배포에서는 API_ORIGIN과 /backend 프록시를 사용하세요.
# NEXT_PUBLIC_API_URL=https://api.example.com
